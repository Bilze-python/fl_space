FROM node:22-bookworm-slim AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    SPACEFL_PUBLIC_DEMO=1 SPACEFL_PUBLIC_TRAINING=1 SPACEFL_OFFLINE_ONLY=1 \
    SPACEFL_DATA_DIR=/var/lib/spacefl MPLCONFIGDIR=/tmp/matplotlib
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-deploy.txt ./
RUN pip install --no-cache-dir -r requirements-deploy.txt \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
       torch==2.5.1 torchvision==0.20.1
COPY --from=frontend /app/node_modules ./node_modules
COPY fl_space ./fl_space
COPY web ./web
COPY deploy/demo_data ./deploy/demo_data
COPY deploy/render/training-entrypoint.sh /usr/local/bin/spacefl-training
RUN useradd --create-home --uid 10001 spacefl \
    && mkdir -p /var/lib/spacefl \
    && chown -R spacefl:spacefl /app /var/lib/spacefl \
    && chmod 755 /usr/local/bin/spacefl-training
EXPOSE 8720
# Initialize ownership of the mounted disk, then drop root before starting Python.
ENTRYPOINT ["/usr/local/bin/spacefl-training"]
